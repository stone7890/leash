# Names, not values. A missing variable is a boot failure that names it.
# See docs/14-deployment.md.

MONGO_URI=mongodb://leash_app:CHANGEME@localhost:27017/leash?replicaSet=rs0&authSource=admin
MONGO_DB=leash

# Which networks this deployment serves. Drives which RPC vars are required.
NETWORKS=sandbox

# There is deliberately no RPC_URL. I8: the endpoint is chosen per record.
#
# This is WHERE the sandbox ledger lives, and nothing more — `sandbox` is still a network in its
# own right, still isolated from mainnet, still carrying the test_ prefix on every record.
#
# This is the LOCAL default only. `make devnet` and `make testnet` set their own endpoint on the
# command line, so the target name is the truth and there is nothing here to edit first.
#
#   http://validator:8899   the local validator in docker-compose.yml   (make start)
RPC_SANDBOX_URL=http://validator:8899
RPC_SANDBOX_FALLBACK_URL=
RPC_MAINNET_URL=
RPC_MAINNET_FALLBACK_URL=

# The sandbox mint is created by `leashctl bootstrap` and written to the shared state volume, so
# it is left blank here on purpose. A mainnet mint is a real published address and must be set.
USDC_MINT_SANDBOX=
USDC_MINT_MAINNET=
TOKEN_PROGRAM_SANDBOX=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
TOKEN_PROGRAM_MAINNET=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA

# Signer only. Never defaulted.
#
# KMS_LOCAL wraps agent keys with a key held on this machine, so the demo runs without an AWS
# account. The configuration REFUSES to combine it with mainnet: a locally-wrapped key protecting
# real money is exactly the shortcut that should not be one flag away.
KMS_LOCAL=true
KMS_KEY_ARN=
AWS_REGION=

# Web only. Never defaulted. Generate one with:  openssl rand -base64 48
SESSION_KEY=
SIWS_DOMAIN=localhost

# Shared between the dashboard and the two Go services, for the internal paths only: key
# provisioning and transaction building. Never defaulted, and never exposed by nginx — it is a
# second lock behind a network boundary, because a boundary that is one misconfigured proxy away
# from being public is not a boundary.
INTERNAL_TOKEN=

SIGNER_BASE_URL=http://localhost:4100
INDEXER_BASE_URL=http://localhost:4300
ALLOWED_ORIGINS=http://localhost:3000

ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=

# How many times one wallet may draw from the sandbox faucet per hour. Exceeding it is the 429
# "the faucet has already funded this wallet recently".
#
# It is a cost limit, not a safety one: the sandbox is play money by design. The USDC is a mint we
# own, so raising it costs nothing. The SOL side is the genuinely scarce part on a public cluster,
# and the faucet already settles for a wallet that is already funded rather than failing when the
# public airdrop is refused.
# How much SOL `leashctl bootstrap` wants in the sandbox's treasury (the mint authority). Two is
# what a local validator grants without complaint. On a public cluster it is real SOL somebody has
# to send by hand, and a sandbox that creates one mint, one token account and a few transfers needs
# far less. Minimum 0.01.
BOOTSTRAP_FUND_SOL=2

# How long `leashctl bootstrap` waits for somebody to fund the treasury by hand, when the cluster's
# own faucet refuses. Only public clusters wait: a local validator airdrops on demand, so a refusal
# there is a fault and stops immediately. Bootstrap prints the address and watches the balance, and
# carries on the moment the SOL lands — there is nothing to re-run. 0 exits instead, which is what
# an unattended build wants.
BOOTSTRAP_FUND_WAIT=30m

# How long a payment with no trace on chain stays `unknown` before the sweep calls it failed and
# gives its reservation back. Per network on purpose: on mainnet a premature `failed` frees budget
# for money that may still move, which is how one challenge gets paid twice; on the sandbox that
# same caution leaves a demo holding a cent until tomorrow. Minimum 2m — the sweep does not look at
# a payment until it is 90s old.
PAYMENT_ABANDONED_AFTER_SANDBOX=10m
PAYMENT_ABANDONED_AFTER_MAINNET=24h

FAUCET_PER_WALLET_PER_HOUR=1
LOG_LEVEL=info
