# Names, not values. A missing variable is a boot failure that names it.
# See docs/14-deployment.md.

MONGO_URI=mongodb://leash_app:CHANGEME@localhost:27017/leash?replicaSet=rs0&authSource=admin
MONGO_DB=leash

# Which networks this deployment serves. Drives which RPC vars are required.
NETWORKS=sandbox

# There is deliberately no RPC_URL. I8: the endpoint is chosen per record.
# In the compose stack this points at the local validator, which IS the sandbox.
RPC_SANDBOX_URL=http://validator:8899
RPC_SANDBOX_FALLBACK_URL=
RPC_MAINNET_URL=
RPC_MAINNET_FALLBACK_URL=

# The sandbox mint is created by `leashctl bootstrap` and written to the shared state volume, so
# it is left blank here on purpose. A mainnet mint is a real published address and must be set.
USDC_MINT_SANDBOX=
USDC_MINT_MAINNET=
TOKEN_PROGRAM_SANDBOX=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
TOKEN_PROGRAM_MAINNET=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA

# Signer only. Never defaulted.
#
# KMS_LOCAL wraps agent keys with a key held on this machine, so the demo runs without an AWS
# account. The configuration REFUSES to combine it with mainnet: a locally-wrapped key protecting
# real money is exactly the shortcut that should not be one flag away.
KMS_LOCAL=true
KMS_KEY_ARN=
AWS_REGION=

# Web only. Never defaulted. Generate one with:  openssl rand -base64 48
SESSION_KEY=
SIWS_DOMAIN=localhost

# Shared between the dashboard and the two Go services, for the internal paths only: key
# provisioning and transaction building. Never defaulted, and never exposed by nginx — it is a
# second lock behind a network boundary, because a boundary that is one misconfigured proxy away
# from being public is not a boundary.
INTERNAL_TOKEN=

SIGNER_BASE_URL=http://localhost:4100
INDEXER_BASE_URL=http://localhost:4300
ALLOWED_ORIGINS=http://localhost:3000

ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=

FAUCET_PER_WALLET_PER_HOUR=1
LOG_LEVEL=info
